# Firebase web configuration (public identifiers; access is controlled by firestore.rules)
FB_API_KEY=
FB_AUTH_DOMAIN=
FB_PROJECT_ID=
FB_STORAGE_BUCKET=
FB_MESSAGING_SENDER_ID=
FB_APP_ID=
FB_MEASUREMENT_ID=

# Server-only PUBG credential. Never place this under runtimeConfig.public.
PUBG_API_KEY=
# Production runtime override, if the key is supplied after the build:
# NUXT_PUBG_API_KEY=
MATCH_URL=

# Optional server-only stale room cleanup. Disabled until explicitly configured.
ROOM_CLEANUP_ENABLED=false
CRON_SECRET=
FIREBASE_ADMIN_PROJECT_ID=
# Leave both blank when the runtime has Application Default Credentials.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
